API_PORT=3001
API_HOST=127.0.0.1
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3001
QVAC_CONFIG_PATH=./qvac.config.json
QVAC_LOG_LEVEL=info
DATABASE_PATH=./diamesh.db

# Model selection. MedPsy runs correctly on Apple Silicon (current target
# hardware). On Intel Mac CPU, MedPsy SIGSEGVs (known QVAC SDK bug — see
# docs/MODEL_NOTES.md); set this to "false" there to fall back to Qwen3.
USE_MEDPSY=true