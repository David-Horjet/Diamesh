# API Server
API_PORT=3001
API_HOST=127.0.0.1
NODE_ENV=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# QVAC
QVAC_CONFIG_PATH=./qvac.config.json
QVAC_LOG_LEVEL=info

# Database
DATABASE_PATH=./diamesh.db

# P2P (optional — leave blank to disable provider mode at startup)
P2P_PROVIDER_PUBLIC_KEY=
P2P_PEER_PUBLIC_KEY=
